# URL publique du site (sans slash final) — utilisée pour le SEO, le sitemap et les images sociales.
SITE_URL=https://www.exemple.fr

# Base PostgreSQL (production : Supabase, pooler en mode transaction, port 6543).
# Laissée vide, le site utilise une base PostgreSQL embarquée (PGlite) dans DATA_DIR.
DATABASE_URL=

# Dossier des données locales (base embarquée) quand DATABASE_URL est vide.
DATA_DIR=./data

# Compte administrateur créé automatiquement s'il n'existe aucun compte.
# Changez le mot de passe depuis l'administration après la première connexion.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
