# URL publique du site (sans slash final) — utilisée pour le SEO, le sitemap et les images sociales.
SITE_URL=https://www.exemple.fr

# Dossier des données persistantes (base SQLite + photos importées).
DATA_DIR=./data

# Compte administrateur créé automatiquement au premier démarrage s'il n'existe aucun compte.
# Changez le mot de passe depuis l'administration après la première connexion.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
